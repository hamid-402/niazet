# Keep this file outside Git after copying it to .env.backup.
DATABASE_URL=postgresql://backup_user:REPLACE_PASSWORD@postgres.example.internal:5432/niazat?sslmode=require
BACKUP_DIR=/secure-backups/niazat
BACKUP_KEY_ID=niazat-backup-2026-q3
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
BACKUP_RETENTION_DAYS=30
BACKUP_MINIMUM_COUNT=7
BACKUP_RETENTION_APPLY=false

# Restore requires a separate target and exact acknowledgement.
BACKUP_FILE=/secure-backups/niazat/REPLACE_BACKUP_FILENAME.niazat.dump.enc
RESTORE_DATABASE_URL=postgresql://restore_user:REPLACE_PASSWORD@restore-postgres.example.internal:5432/niazat_restore?sslmode=require
RESTORE_CONFIRM_DATABASE=niazat_restore
BACKUP_EXPECTED_KEY_ID=niazat-backup-2026-q3
