# Copy to .env.production, replace every REPLACE_* value, and never commit it.
NODE_ENV=production
DATABASE_URL=postgresql://niazat:REPLACE_DB_PASSWORD@postgres.example.internal:5432/niazat?schema=public&sslmode=require
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_ACCESS
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_32_RANDOM_CHARACTERS
OBSERVABILITY_TOKEN=REPLACE_WITH_A_THIRD_32_RANDOM_CHARACTERS
ALERT_WINDOW_SECONDS=300
ALERT_MIN_REQUESTS=20
ALERT_HTTP_5XX_RATE=0.1
ALERT_SLOW_REQUEST_MS=5000
ALERT_COOLDOWN_SECONDS=300
READINESS_TIMEOUT_MS=3000
READINESS_CACHE_TTL_MS=5000
QUEUE_MAX_PENDING=1000
QUEUE_MAX_AGE_SECONDS=900
QUEUE_MAX_DEAD_LETTERS_24H=10
APP_PORT=3001
APP_URL=https://api.example.com
WEB_URL=https://example.com
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=120
BACKGROUND_JOBS_ENABLED=true
FILE_CLEANUP_ENABLED=true
FILE_CLEANUP_INTERVAL_MINUTES=60
FILE_ORPHAN_GRACE_MINUTES=60
FILE_REJECTED_RETENTION_HOURS=24
DATA_CLEANUP_INTERVAL_MINUTES=360
DATA_CLEANUP_BATCH_SIZE=500
SESSION_RETENTION_DAYS=30
OTP_RETENTION_DAYS=7
IDEMPOTENCY_CLEANUP_GRACE_DAYS=1
OUTBOX_SENT_RETENTION_DAYS=30
OUTBOX_DEAD_LETTER_RETENTION_DAYS=90
SIGNED_URL_RETENTION_DAYS=7
JOB_RUN_RETENTION_DAYS=30
ENABLE_SWAGGER=false

# Replace these names and add provider-specific credentials only to .env.production.
LIVE_PROVIDERS_ENABLED=false
PAYMENT_GATEWAY_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=REPLACE_ZARINPAL_MERCHANT_ID
SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=REPLACE_KAVENEGAR_API_KEY
KAVENEGAR_SENDER=REPLACE_SERVICE_LINE
KAVENEGAR_OTP_TEMPLATE=REPLACE_APPROVED_OTP_TEMPLATE
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com
STORAGE_DRIVER=s3
S3_BUCKET=REPLACE_PRIVATE_BUCKET
S3_REGION=REPLACE_REGION
S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=true
S3_PREFIX=niazat-files
S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_ACCESS_KEY
FILE_SCAN_DRIVER=clamav
CLAMAV_HOST=clamav.example.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

NEXT_PUBLIC_API_URL=https://api.example.com/v1
NEXT_PUBLIC_API_BASE_PATH=/api/backend
NEXT_PUBLIC_SITE_URL=https://example.com
