DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niazat?schema=public"

JWT_ACCESS_SECRET="change-me"
DOWNLOAD_TOKEN_SECRET="use-a-different-long-random-secret"
OBSERVABILITY_TOKEN="development-metrics-token"
ALERT_WINDOW_SECONDS=300
ALERT_MIN_REQUESTS=20
ALERT_HTTP_5XX_RATE=0.1
ALERT_SLOW_REQUEST_MS=5000
ALERT_COOLDOWN_SECONDS=300
READINESS_TIMEOUT_MS=3000
READINESS_CACHE_TTL_MS=5000
QUEUE_MAX_PENDING=1000
QUEUE_MAX_AGE_SECONDS=900
QUEUE_MAX_DEAD_LETTERS_24H=10
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

APP_PORT=3001
APP_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

OTP_TTL_SECONDS=120
PAYMENT_GATEWAY_DRIVER="mock"
SMS_DRIVER="mock"
EMAIL_DRIVER="mock"
FILE_SCAN_DRIVER="mock"
# Production: FILE_SCAN_DRIVER="clamav"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
FILE_CLEANUP_ENABLED="true"
FILE_CLEANUP_INTERVAL_MINUTES=60
FILE_ORPHAN_GRACE_MINUTES=60
FILE_REJECTED_RETENTION_HOURS=24
DATA_CLEANUP_INTERVAL_MINUTES=360
DATA_CLEANUP_BATCH_SIZE=500
SESSION_RETENTION_DAYS=30
OTP_RETENTION_DAYS=7
IDEMPOTENCY_CLEANUP_GRACE_DAYS=1
OUTBOX_SENT_RETENTION_DAYS=30
OUTBOX_DEAD_LETTER_RETENTION_DAYS=90
SIGNED_URL_RETENTION_DAYS=7
JOB_RUN_RETENTION_DAYS=30
BACKGROUND_JOBS_ENABLED="true"
AUTO_CONFIRM_DAYS=7
